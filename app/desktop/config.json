{
  "enabled": true,
  "targets": [
    {
      "process": "DingTalk.exe",
      "input_class": "im_chat::InputRichTextEdit"
    },
    {
      "process": "Weixin.exe",
      "input_class": "mmui::ChatInputField"
    },
    {
      "process": "QQ.exe",
      "input_class": "ExEditor-qq-msg-editor",
      "match": "contains",
      "wake_a11y": true
    }
  ],
  "poll_interval_ms": 60,
  "send_key_window_s": 0.8,
  "match_window_s": 1.2,
  "cooldown_s": 4.0,
  "overlay_height_ratio": 0.85,
  "volume": 1.0,
  "watchdog_s": 30,
  "injected_key_policy": "auto",
  "screen_keyboard_processes": [
    "osk.exe",
    "TabTip.exe",
    "TextInputHost.exe",
    "WindowsInternal.ComposableShell.Experiences.TextInput.InputApp.exe"
  ],
  "fallback_vk_buffer": true,
  "ime_aware": true
}